rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. USERS
    

   match /users/{userId} {
   allow read: if request.auth != null;
   allow create, update: if request.auth != null && request.auth.uid == userId;
   allow delete: if false;

   // Subcollection match for saved jobs
   match /savedJobs/{jobId} {
    allow read, write: if request.auth != null && request.auth.uid == userId;
    }
   }

    // 2. COMPANIES
    match /companies/{companyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.createdBy;
      allow update, delete: if request.auth != null 
        && (request.auth.uid == resource.data.createdBy 
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId);
    }

    // 3. JOBS
    match /jobs/{jobId} {
      allow read: if resource.data.isActive == true || (request.auth != null && request.auth.uid == resource.data.recruiterId);
      allow create: if request.auth != null && request.resource.data.recruiterId == request.auth.uid;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.recruiterId;
    }

    // 4. SAVED JOBS
    match /savedJobs/{savedJobId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // 5. APPLICATIONS
    match /applications/{applicationId} {
      allow read, update: if request.auth != null 
        && (request.auth.uid == resource.data.applicantId || request.auth.uid == resource.data.recruiterId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.applicantId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.applicantId;
    }

    // 6. CHATS (CONVERSATIONS)
    match /conversations/{conversationId} {
      allow read, update: if request.auth != null && request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participantIds;

    // 7. MESSAGES
      match /messages/{messageId} {
        allow read, create: if request.auth != null 
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
      }
    }
  }
}